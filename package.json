{
  "name": "sonora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reproductor de musica tipo Spotify: biblioteca local, fuentes libres, modo offline y sin anuncios.",
  "license": "MIT",
  "keywords": [
    "music",
    "player",
    "pwa",
    "offline",
    "open-source"
  ],
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify": "npm run typecheck && vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "idb": "^7.1.1",
    "music-metadata": "^11.16.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
